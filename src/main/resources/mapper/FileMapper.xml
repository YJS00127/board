<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boardsv.file.mapper.FileMapper">

<!--    파일 등록-->
    <insert id="insertAll">
        INSERT INTO file (board_id, saved_name, original_name, size)
        VALUES
        <foreach item="file" collection="files" separator=",">
            (#{file.boardId}, #{file.savedName}, #{file.originalName}, #{file.size})
        </foreach>
    </insert>

</mapper>